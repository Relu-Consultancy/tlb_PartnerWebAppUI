{
    "name": "tlb-partner-portal",
    "private": true,
    "version": "1.0.0",
    "description": "TLB Partner Portal — onboarding and listing-management SPA for The Little Broadway's event/venue/class/program partners.",
    "type": "module",
    "scripts": {
        "dev": "vite --port=8000 --host=0.0.0.0",
        "build": "vite build",
        "preview": "vite preview",
        "clean": "rm -rf dist",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "test:watch": "vitest",
        "test:report": "node scripts/generate-test-report.mjs",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{js,jsx,json,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.14",
        "@vitejs/plugin-react": "^5.0.4",
        "leaflet": "^1.9.4",
        "lucide-react": "^0.546.0",
        "motion": "^12.23.24",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "vite": "^6.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^22.14.0",
        "@vitest/ui": "^4.1.5",
        "autoprefixer": "^10.4.21",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.5.1",
        "msw": "^2.14.3",
        "prettier": "^3.9.9",
        "puppeteer-core": "^25.0.4",
        "tailwindcss": "^4.1.14",
        "tsx": "^4.21.0",
        "typescript": "~5.8.2",
        "typescript-eslint": "^8.70.1",
        "vite": "^6.2.0",
        "vitest": "^4.1.5"
    }
}
